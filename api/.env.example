# NilamTrace FastAPI Backend Environment Configuration
# Optional: Groq Cloud API Key for high-speed LLM land record extraction (llama-3.3-70b-versatile)
# Leave empty to use deterministic Tamil Revenue regex & rules extractor fallback
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_FALLBACK_MODEL=llama-3.1-8b-instant
GROQ_TIMEOUT_SECONDS=15.0
MAX_TOKENS=2048

# App & Network Settings
APP_NAME=NilamTrace API
APP_ENV=development
API_PREFIX=/api
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000,http://127.0.0.1:8000,https://*.vercel.app
