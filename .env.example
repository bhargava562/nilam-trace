# NilamTrace Root Monorepo Environment Configuration
# Optional: Groq Cloud API Key for high-speed LLM land record extraction (llama-3.3-70b-versatile)
# Leave empty to use deterministic Tamil Revenue regex & rules extractor fallback
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
API_BACKEND_URL=http://127.0.0.1:8000
APP_ENV=development
API_PREFIX=/api
